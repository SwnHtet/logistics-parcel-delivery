# Copy this file to ".env" and fill in your own values.

# SQLite (default, zero setup, good for local dev/demo):
DATABASE_URL=sqlite:///./parcel_delivery.db

# PostgreSQL (use this for your real project deployment):
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/parcel_delivery

SECRET_KEY=replace-this-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
